// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @db.Uuid
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memories Memory[]
  edges    MemoryEdge[]
  tags     Tag[]
}

model Memory {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  title            String?
  summary          String?
  rawText          String?
  content          String?
  transcript       String?
  kind             String
  space            String?
  embedding        Bytes?
  sentiments       Json?
  importance       Float    @default(0.5)
  embeddingStatus  String   @default("pending")
  vectorId         String?
  source           String?
  mediaUrl         String?
  mediaThumbnail   String?
  mediaMimeType    String?
  mediaDurationMs  Int?
  mediaSizeBytes   Int?
  linkPreviewUrl   String?
  linkPreviewTitle String?
  linkPreviewDesc  String?
  linkPreviewImage String?
  encryptionScheme String?  @default("aes-256-gcm")
  encrypted        Boolean  @default(false)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      MemoryTag[]
  edgesFrom MemoryEdge[] @relation("EdgesFrom")
  edgesTo   MemoryEdge[] @relation("EdgesTo")

  @@index([userId])
  @@index([createdAt])
}

model MemoryEdge {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  fromId       String   @db.Uuid
  toId         String   @db.Uuid
  relationship String
  strength     Float    @default(0.5)
  createdAt    DateTime @default(now())

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  from Memory @relation("EdgesFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Memory @relation("EdgesTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fromId])
  @@index([toId])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories MemoryTag[]

  @@unique([userId, name])
  @@index([userId])
}

model MemoryTag {
  memoryId String @db.Uuid
  tagId    String @db.Uuid

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memoryId, tagId])
}
